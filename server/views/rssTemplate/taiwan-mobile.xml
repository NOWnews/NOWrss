{% extends "./base/taiwanMobileBase.xml" %}

{% block item %}
    {% for item in items %}{% if item.id != 2582267 %}
        <item>
            <id>{{item.id}}</id>
            <title>{{ item.title }}</title>
            <link>{{ item.url }}</link>
            <description>
                <![CDATA[
                    {% if item.mainPhotoUrl %}<div class="main-photo"><img src="http://imgapiv2.nownews.com/?h=545&q=70&src={{ item.TaiwanMobileMainPhoto }}" width="320px;" /><cite>{{ item.mainPhotoDesc }}</cite></div>{% endif %}%THISISAD%{{ item.description | safe }}
                ]]>
            </description>
            <summary>
                {{ item.summary }}
            </summary>
            <guid isPermaLink="true">{{ item.url }}</guid>
            <subcategory>
                <![CDATA[
                    {{ item.subcategory }}
                ]]>
            </subcategory>
            <author>{{ item.author }}</author>
            <pubDate>{{ item.TaiwanMobileDate }}</pubDate>
        </item>
    {% endif %}{% endfor %}
{% endblock %}
