{% extends "./base/base.xml" %}

{% block item %}
  {% for item in items %}
    <item>
      <title>{{ item.title }}</title>
      <link>{{ item.link }}</link>
      <guid>{{ item.guid }}</guid>
      <pubDate>{{ item.date }}</pubDate>
      <author>{{ item.author }}</author>
      <description>{{ item.description }}</description>
      <content:encoded>
        <![CDATA[
        <!doctype html>
        <html lang="en" prefix="op: http://media.facebook.com/op#">
          <head>
            <meta charset="utf-8">
            <link rel="canonical" href="{{ item.link }}">
            <title>{{ item.title }}</title>
            <meta property="op:markup_version" content="v1.0">
            <meta property="fb:likes_and_comments" content="enable">
            <meta property="fb:use_automatic_ad_placement" content="true">
            <meta property="fb:op-recirculation-ads" content="placement_id=1789112951323406_1932225000345533">
          </head>
          <body>
            <article>
              <header>
                <h1>★{{ item.title }}</h1>
                <time class="op-published" datetime="{{ item.isoDate }}">{{ item.date }}</time>
                <time class="op-modified" dateTime="{{ item.isoDate }}">{{ item.date }}</time>
                <address>
                  {{ item.author }}
                </address>

                <figure class="op-ad">
                  <iframe width="300" height="250" style="border:0; margin:0;" src="https://www.facebook.com/adnw_request?placement=1789112951323406_1797144030520298&adtype=banner300x250"></iframe>
                </figure>

                {# 主要圖片 #}
                {% if item.imgUrl %}
                  <figure>
                    <img src="{{ item.imgUrl }}"/>
                    <figcaption>{{ item.imgTitle }}</figcaption>
                  </figure>
                {% endif %}

                {# 圖片新聞 #}
                {% if item.photos and item.photos.length > 0 %}
                  <figure class="op-slideshow">
                    {% for photo in item.photos %}
                    <figure>
                      <img src="{{ photo.thumbnail }}" />
                    </figure>
                    <figcaption>{{ photo.desc }}</figcaption>
                    {% endfor %}
                  </figure>
                {% endif %}


              </header>

              {{ item.body | safe }}

              <figure class="op-ad">
                <iframe width="300" height="250" style="border:0; margin:0;" src="https://www.facebook.com/adnw_request?placement=1789112951323406_1797144030520298&adtype=banner300x250"></iframe>
              </figure>

              <figure class="op-tracker">
                  <iframe>
                    <script>
                      (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
                      (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
                      m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
                      })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

                      ga('create', 'UA-4021556-54', 'auto');
                      ga('create', 'UA-4021556-26', {'name':'26'});
                      ga('set', 'campaignSource', 'Facebook');
                      ga('set', 'campaignMedium', 'Facebook Instant Article');
                      ga('send', 'pageview', {title: '{{ item.title }}'});
                      ga('26.send', 'pageview', {title: '{{ item.title }}'});
                    </script>
                  </iframe>
              </figure>

              <figure class="op-tracker">
                  <iframe>
                    {# Start Alexa Certify Javascript #}
                    <script type="text/javascript">
                    _atrk_opts = { atrk_acct:"3yibi1aoZM00M2", domain:"nownews.com",dynamic: true};
                    (function() { var as = document.createElement('script'); as.type = 'text/javascript'; as.async = true; as.src = "https://d31qbv1cthcecs.cloudfront.net/atrk.js"; var s = document.getElementsByTagName('script')[0];s.parentNode.insertBefore(as, s); })();
                    </script>
                    <noscript><img src="https://d5nxst8fruw4z.cloudfront.net/atrk.gif?account=3yibi1aoZM00M2" style="display:none" height="1" width="1" alt="" /></noscript>
                    {# End Alexa Certify Javascript #}
                  </iframe>
              </figure>

              <figure class="op-tracker">
                  <iframe>
                    {# Begin comScore all site Tag #}
                    <script>
                      var _comscore = _comscore || [];
                      _comscore.push({ c1: "2", c2: "11473067" });
                      (function() {
                        var s = document.createElement("script"), el = document.getElementsByTagName("script")[0]; s.async = true;
                        s.src = (document.location.protocol == "https:" ? "https://sb" : "http://b") + ".scorecardresearch.com/beacon.js";
                        el.parentNode.insertBefore(s, el);
                      })();
                    </script>
                    <noscript>
                      <img src="http://b.scorecardresearch.com/p?c1=2&c2=11473067&cv=2.0&cj=1" />
                    </noscript>
                    {# End comScore Tag #}
                  </iframe>
              </figure>

              <figure class="op-tracker">
                  <iframe>
                    <script type="text/javascript">
                      function sendPageView () {
                          var guidGenerator = function() {
                              var S4 = function() {
                                 return (((1+Math.random())*0x10000)|0).toString(16).substring(1);
                              };
                              return (S4()+S4()+"-"+S4()+"-"+S4()+"-"+S4()+"-"+S4()+S4()+S4());
                          };

                          var NOW_cookie = $.cookie('NOW_personalize');
                          if (!NOW_cookie){
                              NOW_cookie = guidGenerator();
                          }
                          $.cookie('NOW_personalize', NOW_cookie);

                          var pageviews = $.ajax({
                              url: 'https://v4api.nownews.com/pageviews',
                              headers: {
                                  'X-NOWnews-API': 'YouCanSeeMeJohnCena'
                              },
                              method: 'PUT',
                              data: {
                                  cookie: NOW_cookie,
                                  menuId: '{{ item.menuId }}',
                                  newsId: '{{ item.guid }}',
                                  queryString: 'source=FacebookInstantArticle',
                                  url: '{{ item.parseUrl }}'
                              },
                              dataType: 'json'
                          });

                          return;
                      }

                      sendPageView();
                    </script>
                  </iframe>
              </figure>

              <figure class="op-tracker">
                  <iframe>
                    <script type="text/javascript">
                      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
                      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
                      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
                      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
                      document,'script','https://connect.facebook.net/en_US/fbevents.js');
                      fbq('init', '1768967316716713'); // Insert your pixel ID here.
                      fbq('track', 'PageView');
                      fbq('track', 'ViewContent', {
                        'title': ia_document.title,
                        'url': '{{ item.link }}',
                        'cate': '{{ item.cate }}',
                        'newsId': '{{ item.newsId }}',
                        'author': '{{ item.author }}'
                      });
                    </script>
                  </iframe>
              </figure>

              <footer>
                <aside>NOWnews 今日傳媒股份有限公司</aside>
                <small>Copyright © 2016 今日傳媒股份有限公司</small>
              </footer>
            </article>
          </body>
        </html>
        ]]>
      </content:encoded>
    </item>
  {% endfor %}
{% endblock %}
