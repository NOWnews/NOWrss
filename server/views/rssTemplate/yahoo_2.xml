{% extends "./base/yahooBase.xml" %}

{% block item %}
    {% for item in items %}
        <item>
            <title>{{ item.title }}</title>
            <link>{{ item.url }}</link>
            <description>{{ item.summary }}</description>
            <pubDate>{{ item.UTCdate }}</pubDate>
            <guid isPermaLink="true">{{ item.url }}</guid>
            <category>{{ item.subcategory }}</category>
            <author>{{ item.author }}</author>
            {% if item.mainPhotoUrl %}<media:content url="{{ item.mainPhotoUrl }}" type="image/jpeg"></media:content>{% endif %}
            <content:encoded>
            {% if item.mainPhotoUrl %}<div class="main-photo"><img src="{{ item.mainPhotoUrl }}" alt="{{ item.mainPhotoDesc }}" /></div>{% endif %}{{ item.description }}
            {% if item.sameCatNews %}
                <div>
                    <p>更多 NOWnews 今日新聞報導</p>
                    {% for n in item.sameCatNews %}
                        <a href="{{n.completeUrl}}?utm_source=yahoo&amp;utm_medium=rss&amp;utm_campaign={{item.deliveryDate}}">{{n.title}}</a><br/>
                    {% endfor %}
                </div>
            {% endif %}
            </content:encoded>
        </item>
    {% endfor %}
{% endblock %}
