{% extends "./base/base.xml" %}
{% block item %}
    {% for item in items %}
        <item>
            <id>{{item.id}}</id>
            <title><![CDATA[ {{ item.title }} ]]></title>
            <link>{{ item.url }}</link>
            <description>
                <![CDATA[
                    {{ item.mainPhotoBody | safe }}{{ item.description | safe }}
                    {% if item.sameCatNews %}
                        <div>
                            <h2>相關新聞</h2>
                            {% for n in item.sameCatNews %}
                                <h3><a href="{{n.completeUrl}}?rss=sinatw">{{n.title}}</a></h3>
                            {% endfor %}
                        </div>
                    {% endif %}
                ]]>
            </description>
            <summary>
                {{ item.summary }}
            </summary>
            <guid isPermaLink="true">{{ item.url }}</guid>
            <subcategory>
                <![CDATA[
                    {{ item.subcategory }}
                ]]>
            </subcategory>
            <author>{{ item.author }}</author>
            <pubDate>{{ item.date }}</pubDate>
        </item>
    {% endfor %}
{% endblock %}
