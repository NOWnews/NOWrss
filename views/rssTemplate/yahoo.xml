{% extends "./base/base.xml" %}

{% block item %}
    {% for item in items %}
        <item>
            <title>{{ item.title }}</title>
            <link>{{ item.url }}</link>
            <description>
                <![CDATA[
                    {{ item.description | safe }}
                ]]>
            </description>
            <summary>
              {{ item.summary }}
            </summary>
            <guid isPermaLink="true">{{ item.url }}</guid>
            <category>
                <![CDATA[
                    {{ item.subcategory }}
                ]]>
            </category>
            <author>{{ item.author }}</author>
            <pubDate>{{ item.date }}</pubDate>
        </item>
    {% endfor %}
{% endblock %}
